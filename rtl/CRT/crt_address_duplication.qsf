# No speculative synthesis-name fallback. Mapping does not apply Fitter
# DUPLICATE_ATOMs. The staged user-run flow resolves exact map sources before
# fitting. A direct Fitter settings read without that file is rejected.
# Only the staged runner is supported for a measured candidate build.
if {[file exists output_files/crt_address_duplication_resolved.qsf]} {
    source output_files/crt_address_duplication_resolved.qsf
} elseif {[info exists quartus(nameofexecutable)] && [string match *quartus_fit* $quartus(nameofexecutable)]} {
    error "Run tests/run_crt_read_address_quartus.sh to resolve fresh map targets before fitting"
}
