--- a/rtl/vga.v
+++ b/rtl/vga.v
@@ -104,6 +104,10 @@
 wire[15:0] V_total;
 wire[15:0] V_pulse_start;
 wire[15:0] V_pulse_end;
+// Verilog-2001 only: move the terminal subtraction off V_total's fan-in.
+// The unsized old subtraction never terminates a zero total.
+wire [16:0] terminal_count = {1'b0,v_cnt} + 17'd1;
+wire vertical_terminal = (V_total != 16'd0) && (terminal_count >= {1'b0,V_total});
 
 assign H_pulse_start = (interlaced && field) ? (H+HFP) >> 1 : H+HFP;
 assign V_total       = (interlaced && field) ? V+VBP+VFP+VS - 1'b1 : V+VBP+VFP+VS;
@@ -720,7 +724,7 @@
                                                          
    // the vertical counter is processed at the begin of each hsync
    if (h_cnt == H+HFP) begin
-     if (v_cnt >= V_total-1) begin                             //V_total changes on interlaced field by 1             
+     if (vertical_terminal) begin                             //V_total changes on interlaced field by 1
        v_cnt <= (interlaced && !field) ? 1'b1 : 1'b0;          //vcount depends on field
      end else begin 
        v_cnt <= interlaced ? v_cnt + 10'd2 : v_cnt + 10'd1;    //interlaced alternate 2 lines according to field                         
